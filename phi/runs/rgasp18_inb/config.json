  "cross_section_model": {
    "formula": "dsig/dt = (1 - W2_th/W2)^alf2 * W^alf3 * (1+Q2/mphi2)^(-nuT) * bt * exp(bt*t) * (1 + cR*Q2/mphi2)",
    "description": "Exponential t-dependence with threshold factor and sigma_L/sigma_T ratio",
    "parameters": {
      "alf2": {
        "value": 2.0,
        "description": "Threshold exponent: (1 - W2_th/W2)^alf2"
      },
      "alf3": {
        "value": 0.2,
        "description": "W power law: W^alf3"
      },
      "bt": {
        "value": 1.3479106993442127,
        "description": "t-slope [GeV^-2]: exp(bt * t)"
      },
      "nuT": {
        "value": 2.072040990640955,
        "description": "Q2 suppression: (1 + Q2/mphi2)^(-nuT)"
      },
      "cR": {
        "value": 1.0,
        "description": "sigma_L/sigma_T ratio: sigma_L = cR * Q2/mphi2 * sigma_T"
      }
    }
  },
  "fit_parameters": {
    "free": [
      "bt",
      "nuT"
    ],
    "fixed": [
      "alf2",
      "alf3",
      "cR"
    ],
    "bounds": {
      "alf2": [
